{
	"name": "sporeward",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"engines": {
		"node": ">=24.3.0"
	},
	"scripts": {
		"dev:web": "npm run dev --workspace @sporeward/web",
		"dev:server": "npm run dev --workspace @sporeward/server",
		"dev:mobile": "npm run start --workspace @sporeward/mobile",
		"android": "npm run android --workspace @sporeward/mobile",
		"typecheck": "npm run typecheck --workspaces --if-present",
		"test": "vitest run",
		"check": "npm run typecheck && npm test && npm run check:lab",
		"android:field": "npm run android:field --workspace @sporeward/mobile",
		"build:lab": "node scripts/build-cleaning-lab.mjs",
		"check:lab": "node scripts/build-cleaning-lab.mjs --check",
		"check:android": "node scripts/check-android-apk.mjs",
		"android:emulator": "npm run android:emulator --workspace @sporeward/mobile",
		"dev:mobile:local": "npm run start:local --workspace @sporeward/mobile"
	},
	"devDependencies": {
		"@types/node": "^24.0.0",
		"esbuild": "^0.28.2",
		"typescript": "~6.0.3",
		"vitest": "^5.0.4"
	}
}
