import {writeFile} from 'node:fs/promises';
import {resizeOutbreak} from '../../apps/server/src/spatial/resize.ts';
import {contour} from '../../apps/server/src/spatial/contour.ts';
import {cellKey,tilePosition} from '../../apps/server/src/spatial/access.ts';
const cells=[{x:70000,y:38000},{x:70001,y:38000},{x:70002,y:38000},{x:70000,y:38001},{x:70000,y:38002}];
const access=[];for(let x=69997;x<=70006;x++)for(let y=37997;y<=38006;y++)access.push({x,y,ways:[1]});
let outbreak={id:'branch-preview',name:'Branch preview',accessWay:1,cells,ring:contour(cells,undefined,'branch-preview')};
const heat=new Map([[cellKey(cells[2]),10],[cellKey(cells[1]),9]]),frames=[];
for(const size of [5,5.05,5.25,5.5,5.75,6,6.5,7,7.5,7.25,6.75,6.25,6,5.75,5.25,4.75,4.25,3.75,3.25,2.75,2.25,1.75,1.25,.75,.5]){
 outbreak=resizeOutbreak(outbreak,size,access,new Set(),heat);
 frames.push({size,phase:frames.length<9?'Growing':'Withering',points:outbreak.ring.map(p=>{const [x,y]=tilePosition(p);return [(x-69997)*64,(y-37997)*64];}),cells:outbreak.cells.map(c=>[(c.x-69997)*64,(c.y-37997)*64])});
}
const html=`<!doctype html><html lang="en"><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Sporeward — procedural contour preview</title><style>body{margin:0;background:#10271f;color:#eef8ef;font:18px system-ui}main{max-width:850px;margin:auto;padding:28px}h1{font-size:30px;margin-bottom:8px}p{color:#b9cfbf;line-height:1.5}svg{width:100%;max-height:65vh;background:#163a2b;border-radius:24px}button{background:#9be9b4;color:#10271f;border:0;border-radius:12px;padding:12px 20px;font:inherit;cursor:pointer}input[type=range]{width:100%;margin:24px 0}label{margin-left:20px}#status{font-weight:700;color:#c0a2ff}rect{fill:none;stroke:#9be9b4;stroke-dasharray:4 5;opacity:.35}path{stroke:#ddb5ff;stroke-width:3;fill:#a847de;fill-opacity:.5}</style><main><h1>Sporeward</h1><p>Procedural outline preview: an edge grows gradually, then selected branches wither. The visible outline is also used for contact matching.</p><svg viewBox="0 0 640 640" aria-label="Outbreak contour"><g id="cells" hidden></g><path id="shape"/></svg><input id="frame" type="range" min="0" max="${frames.length-1}" value="0" aria-label="Lifecycle frame"><button id="play">Play</button><label><input id="grid" type="checkbox">Show internal cells</label><p id="status"></p><p>This preview steps through geometry changes; it does not simulate scoring or real-time balance.</p></main><script>const frames=${JSON.stringify(frames)},slider=document.querySelector('#frame'),shape=document.querySelector('#shape'),cells=document.querySelector('#cells'),status=document.querySelector('#status');let timer;function draw(){const f=frames[Number(slider.value)];shape.setAttribute('d',f.points.map((p,i)=>(i?'L':'M')+p.join(' ')).join(' ')+' Z');shape.style.fill=f.phase==='Growing'?'#a847de':'#52baab';cells.innerHTML=f.cells.map(p=>'<rect x="'+p[0]+'" y="'+p[1]+'" width="64" height="64"/>').join('');status.textContent=f.phase+' · '+f.size+' cell equivalents';}slider.oninput=draw;document.querySelector('#grid').onchange=e=>cells.style.display=e.target.checked?'':'none';cells.style.display='none';document.querySelector('#play').onclick=()=>{if(timer){clearInterval(timer);timer=null;document.querySelector('#play').textContent='Play';return;}document.querySelector('#play').textContent='Pause';timer=setInterval(()=>{slider.value=(Number(slider.value)+1)%frames.length;draw();},450);};document.addEventListener('visibilitychange',()=>{if(document.hidden){clearInterval(timer);timer=null;document.querySelector('#play').textContent='Play';}});draw();</script></html>`;
await writeFile('docs/visualizations/outbreak-contours.html',html);console.log('Updated procedural contour preview.');
