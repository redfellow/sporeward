{
  "name": "@sporeward/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android --device",
    "typecheck": "tsc -p tsconfig.json",
    "android:field": "expo run:android --variant release --device --no-bundler",
    "android:emulator": "expo run:android --device emulator-5554",
    "start:local": "expo start --dev-client --localhost --port 8081"
  },
  "dependencies": {
    "@maplibre/maplibre-react-native": "^11.5.0",
    "@shopify/react-native-skia": "2.6.2",
    "@sporeward/game": "0.1.0",
    "@sporeward/protocol": "0.1.0",
    "@sporeward/rendering": "0.1.0",
    "base64-js": "^1.5.1",
    "expo": "~57.0.28",
    "expo-dev-client": "~57.0.20",
    "expo-file-system": "~57.0.7",
    "expo-location": "~57.0.21",
    "expo-secure-store": "~57.0.4",
    "expo-sharing": "~57.0.23",
    "expo-sqlite": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "expo-task-manager": "~57.0.21",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@types/react": "~19.2.2"
  },
  "expo": {
    "autolinking": {
      "nativeModulesDir": "./modules"
    }
  }
}
