{
  "expo": {
    "name": "Sporeward",
    "slug": "sporeward",
    "version": "0.1.0",
    "userInterfaceStyle": "dark",
    "plugins": [
      "expo-dev-client",
      "expo-sqlite",
      "expo-sharing",
      [
        "expo-location",
        {
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      "@maplibre/maplibre-react-native",
      "expo-secure-store",
      "./plugins/with-android-toolchain.cjs"
    ],
    "android": {
      "package": "com.sporeward.app",
      "permissions": [
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.POST_NOTIFICATIONS"
      ]
    },
    "ios": {
      "bundleIdentifier": "com.sporeward.app",
      "supportsTablet": true
    },
    "scheme": "sporeward"
  }
}
